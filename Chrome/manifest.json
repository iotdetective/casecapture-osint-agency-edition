{
  "manifest_version": 3,
  "name": "CaseCapture OSINT",
  "description": "Local forensic-style web capture tool for OSINT documentation.",
  "version": "0.5.1",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "CaseCapture OSINT",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
